DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 96M
    php_value max_file_uploads 60
    php_value max_input_time 180
    php_value max_execution_time 180
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 96M
    php_value max_file_uploads 60
    php_value max_input_time 180
    php_value max_execution_time 180
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 96M
    php_value max_file_uploads 60
    php_value max_input_time 180
    php_value max_execution_time 180
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "\.(log|sql)$">
    Require all denied
</FilesMatch>
