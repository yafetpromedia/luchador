DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 80M
    php_value max_file_uploads 40
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 80M
    php_value max_file_uploads 40
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 80M
    php_value max_file_uploads 40
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "\.(log|sql)$">
    Require all denied
</FilesMatch>
